{
  "expo": {
    "name": "EventEasePinpin",
    "slug": "exam-mobile-project",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "exammobileproject",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F6F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0E1412",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-font",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["fr", "en"],
            "android": ["fr", "en"]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EventEase utilise votre position pour afficher la distance jusqu'aux événements."
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
